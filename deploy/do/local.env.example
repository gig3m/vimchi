# Copy to local.env (gitignored) and fill in. Never commit local.env.
#
#   cp deploy/do/local.env.example deploy/do/local.env
#
# create-droplet.sh, deploy.sh, and pull-backup.sh source local.env when it exists.

# --- droplet create (create-droplet.sh) ---
DIGITALOCEAN_TOKEN=
# Linux user created on the droplet, and the login public key.
VIMCHI_SSH_USER=deploy
VIMCHI_SSH_PUBKEY=$HOME/.ssh/id_ed25519.pub
# Name of that key as it appears on the DigitalOcean account (account/keys).
VIMCHI_DO_SSH_KEY_NAME=

# Optional SSH trust material. Each value is a single line. Leave empty to skip.
# VIMCHI_SSH_USER_CA: the user CA public key. Certs it signs may log in as VIMCHI_SSH_USER.
# VIMCHI_SSH_REVOKED_KEYS: one revoked public key.
# VIMCHI_SSH_HOST_CA: a known_hosts line, e.g. @cert-authority * ssh-ed25519 AAAA... comment
VIMCHI_SSH_USER_CA=
VIMCHI_SSH_REVOKED_KEYS=
VIMCHI_SSH_HOST_CA=

# Optional. When set, the new droplet joins Tailscale and public SSH (port 22) stays closed.
# Leave unset to open 22/tcp instead. create-droplet.sh mints a one-time auth key from this.
TAILSCALE_API_KEY=

# Optional DNS. When both Porkbun keys are set, A records for VIMCHI_DOMAIN and www are updated.
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
VIMCHI_DOMAIN=vimchi.dev

VIMCHI_DO_REGION=nyc3
VIMCHI_DO_SIZE=s-1vcpu-1gb
VIMCHI_DROPLET_NAME=vimchi

# --- deploy and backup ---
# SSH destination: user@host, or a Host alias from your ssh config.
VIMCHI_SSH_HOST=
# Local directory pull-backup.sh writes vimchi.db into. Schedule the script yourself.
VIMCHI_BACKUP_DEST=
# Public origin deploy.sh curls after a restart.
VIMCHI_PUBLIC_URL=https://vimchi.dev
