# Copy to docker/.env (gitignored). Used by docker/up.sh and docker compose.
VIMCHI_PORT=8080
VIMCHI_BASE_URL=http://localhost:8080
VIMCHI_SECURE_COOKIES=0
VIMCHI_TRUST_PROXY=0
TZ=UTC

# Optional GitHub OAuth app. Callback: $VIMCHI_BASE_URL/auth/github/callback
VIMCHI_GITHUB_CLIENT_ID=
VIMCHI_GITHUB_CLIENT_SECRET=
