# GitHub OAuth app (https://github.com/settings/developers).
# Callback URL must be $VIMCHI_BASE_URL/auth/github/callback.
# Without these the server still runs; /auth/github/login returns 503.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public origin the browser uses. In dev this is the Vite server, which
# proxies /api and /auth to this process.
VIMCHI_BASE_URL=http://localhost:5317

VIMCHI_ADDR=:8080
VIMCHI_DB=vimchi.db
VIMCHI_STATIC=../dist

# Set to 1 behind a TLS-terminating proxy so cookies get the Secure flag.
VIMCHI_SECURE_COOKIES=0
